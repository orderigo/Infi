# Reactor API Key
REACTOR_API_KEY=rk_your_api_key_here

# Supabase Auth Credentials (supports both NEXT_PUBLIC_SUPABASE_* and SUPABASE_*)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Cloud Vertex AI / Gemini Live service account.
# Required for Voice Agent. Store this server-only value as one line of JSON
# (or a base64 encoding of that JSON) in the deployment environment.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","client_email":"your-sa@your-project-id.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}

# Optional Vertex AI routing overrides.
# us-central1 is the default; use global only when it is enabled for your project.
GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_CLOUD_PROJECT=your-project-id

# Optional: pin a supported Gemini Live model.
# GEMINI_LIVE_MODEL=gemini-live-2.5-flash-native-audio

# Reactor API Key
REACTOR_API_KEY=rk_your_api_key_here

# Supabase Auth Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Cloud Vertex AI / Gemini Credentials (JSON string or base64 string)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","client_email":"your-sa@project.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\n..."}

# Optional GCP location override (defaults to us-central1)
GOOGLE_CLOUD_LOCATION=us-central1

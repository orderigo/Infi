# Reactor API Key
REACTOR_API_KEY=rk_your_api_key_here

# Optional Fast H3 Episodes AI writer. Without this key, episode scenes are
# composed by hand in the new Episodes tab.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Supabase Auth Credentials (supports both NEXT_PUBLIC_SUPABASE_* and SUPABASE_*)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Comma-separated Supabase user emails allowed to promote community ideas.
ADMIN_EMAILS=admin@example.com

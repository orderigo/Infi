# Reactor API Key (Required for Real-time Video Generation)
REACTOR_API_KEY=rk_your_api_key_here

# Google Gemini / Vertex AI Authentication (Choose Option A or Option B)

# Option A: Google Gemini API Key
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
NEXT_PUBLIC_GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Option B: Google Cloud Vertex AI Service Account JSON
# 1) Path to Service Account JSON Key file
GOOGLE_APPLICATION_CREDENTIALS=./google-service-account.json

# 2) Or raw/Base64 Google Service Account JSON string (useful for Railway / Render env vars)
GOOGLE_SERVICE_ACCOUNT_JSON='{"type": "service_account", "project_id": "your-gcp-project", ...}'
